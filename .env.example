# Copia este ficheiro para .env e preenche os valores. Nunca versiones o .env.
# Onde obter: Supabase → Project Settings → API Keys.
# VITE_SUPABASE_URL: o URL do projecto, sem /rest/v1/ no fim (ex.: https://xxxx.supabase.co).
# VITE_SUPABASE_PUBLISHABLE_KEY: a publishable key (sb_publishable_...). Nunca a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
